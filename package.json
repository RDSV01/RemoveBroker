{
  "name": "removebroker",
  "version": "1.0.0",
  "private": true,
  "description": "Alternative open source a Incogni. Supprime automatiquement vos donnees personnelles chez les data brokers.",
  "main": "apps/desktop/main.cjs",
  "author": {
    "name": "RemoveBroker contributors",
    "email": "72087745+RDSV01@users.noreply.github.com"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/RDSV01/RemoveBroker.git"
  },
  "homepage": "https://github.com/RDSV01/RemoveBroker",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/server",
    "apps/web",
    "apps/desktop"
  ],
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "imapflow": "^1.0.181",
    "mailparser": "^3.7.2",
    "nodemailer": "^9.0.5",
    "playwright-core": "^1.50.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @removebroker/server",
    "dev:web": "npm run dev --workspace @removebroker/web",
    "build": "npm run build --workspace @removebroker/web && npm run build --workspace @removebroker/server",
    "start": "node apps/server/dist/main.js",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:build:local": "node scripts/build-catalog.mjs --from-clones ..",
    "catalog:enrich": "node scripts/enrich-catalog.mjs",
    "icon": "node scripts/make-icon.mjs 512",
    "browsers:install": "node scripts/install-browsers.mjs",
    "desktop": "electron apps/desktop/main.cjs",
    "dist": "npm run build && npm run icon && electron-builder",
    "dist:win": "npm run build && npm run icon && electron-builder --win",
    "dist:mac": "npm run build && npm run icon && electron-builder --mac",
    "dist:linux": "npm run build && npm run icon && electron-builder --linux",
    "typecheck": "tsc -b apps/server apps/web",
    "test": "npm run build --workspace @removebroker/server && node --test apps/server/dist/**/*.test.js",
    "test:ui": "node scripts/test-ui.mjs",
    "test:followup": "node scripts/test-followup.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "yaml": "^2.7.0"
  }
}
